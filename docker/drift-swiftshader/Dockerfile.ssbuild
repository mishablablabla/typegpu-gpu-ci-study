FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git cmake ninja-build clang python3 pkg-config file libx11-dev libxcb1-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*
RUN git --version && cmake --version | head -1 && clang --version | head -1

#   docker build -f docker/swiftshader/Dockerfile.lavapipe-pinned -t tgci-lavapipe-pinned-oracle-ext:arm64 .
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ARG NODE_VERSION=24.21.0
ARG UBUNTU_SNAPSHOT=20261015T000000Z
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN rm -f /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list && \
    printf 'Types: deb\nURIs: https://snapshot.ubuntu.com/ubuntu/%s/\nSuites: noble noble-updates noble-security\nComponents: main universe\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' "$UBUNTU_SNAPSHOT" > /etc/apt/sources.list.d/snapshot.sources
RUN apt-get -o Acquire::Retries=5 update && apt-get install -y --no-install-recommends curl xz-utils mesa-vulkan-drivers libvulkan1 vulkan-tools && rm -rf /var/lib/apt/lists/* \
 && test "$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers)" = "25.2.8-0ubuntu0.24.04.4" && test "$(dpkg-query -W -f='${Version}' libllvm20)" = "1:20.1.2-0ubuntu1~24.04.3" && test "$(dpkg-query -W -f='${Version}' libvulkan1)" = "1.3.275.0-1build1" && echo "pinned versions verified" \
 && dpkg-query -W -f='${Package} ${Version}\n' mesa-vulkan-drivers libllvm20 libvulkan1 libdrm2 libstdc++6 libc6 > /pinned-package-versions.txt
RUN arch="$(dpkg --print-architecture)"; case "$arch" in amd64) na=x64;; arm64) na=arm64;; esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${na}.tar.xz" | tar -xJ -C /usr/local --strip-components=1
WORKDIR /work/webgpu-poc
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vitest.config.mts harness.ts step1.mjs ./
COPY lib ./lib
COPY diff ./diff
COPY ported ./ported
COPY third_party/adapter-probe.js third_party/dawn-node-provider.js third_party/package.json ./third_party/
COPY evaluator/engine-allrows.ts ./evaluator/
COPY evaluator/dump-bits-ext.test.ts evaluator/dump-bits-ext-f16.test.ts evaluator/vitest.config.mts ./evaluator/
COPY docker/in-container ./docker/in-container
